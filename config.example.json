  "zones": {
    "enabled": true,
    "radius": 10
  },
  "pvp_conquest": {
    "enabled": false,
    "clear_ratio": 0.8,
    "min_attack_power": 50000,
    "nobles_per_target": 4,
    "arrival_buffer_seconds": 2,
    "scout_amount": 5,
    "dynamic_moral_night_bonus": false
