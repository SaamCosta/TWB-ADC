{
  "build": {
    "name": "tw_bot",
    "version": "3.4",
    "author": "stefan2200"
  },
  "server": {
    "server": "nlc1",
    "endpoint": "https://nlc1.tribalwars.nl/game.php",
    "server_on_twstats": false
  },
  "reporting": {
    "enabled": true,
    "connection_string": "file://cache/logs/twb_{ts}.log"
  },
  "notifications": {
    "enabled": false,
    "channel_id": "",
    "token": ""
  },
  "bot": {
    "active_hours": "6-23",
    "delay_factor": 1.0,
    "active_delay": 200,
    "inactive_still_active": true,
    "inactive_delay": 2000,
    "add_new_villages": true,
    "village_name_template": "Village {num}",
    "village_name_number_length": 3,
    "auto_set_village_names": false,
    "user_agent": null,
    "check_update": true,
    "max_cached_reports": 1000,
    "humanize_village_order": false,
    "jitter_min": 20,
    "jitter_max": 120,
    "attention_lag_chance": 0.0,
    "attention_lag_extra_min": 600,
    "attention_lag_extra_max": 1800
  },
  "building": {
    "manage_buildings": true,
    "default": "purple_predator",
    "max_lookahead": 2,
    "max_queued_items": 2,
    "auto_queue_len": false,
    "premium_max_queued_items": 5
  },
  "units": {
    "recruit": true,
    "upgrade": true,
    "default": "basic",
    "batch_size": 25,
    "manage_defence": false,
    "remove_manual_queued": false,
    "randomize_unit_queue": true
  },
  "inheritance": {
    "mode": "empire_ratio"
  },
  "empire": {
    "offensive_ratio": 1,
    "defensive_ratio": 3
  },
  "watchtower": {
    "enabled": false,
    "min_spacing": 16,
    "min_villages": 5
  },
  "profile_templates": {
    "offensive": {
      "building": "purple_predator_into_off",
      "units": "offensive"
    },
    "defensive": {
      "building": "purple_predator_into_def",
      "units": "defensive_1",
      "support_others": true
    },
    "watchtower": {
      "building": "watchtower_support",
      "units": "watchtower_support",
      "support_others": true,
      "prioritize_building": true
    }
  },
  "village_template": {
    "inherit_on_first_run": true,
    "profile": null,
    "building": null,
    "units": "basic",
    "managed": true,
    "active_hours": null,
    "delay_factor": null,
    "keep_resources": {},
    "conquest_enabled": true,
    "additional_farms": [],
    "prioritize_building": false,
    "prioritize_snob": false,
    "trade_for_premium": false,
    "gather_enabled": false,
    "gather_selection": 1,
    "advanced_gather": true,
    "snobs": 0,
    "evacuate_fragile_units_on_attack": false,
    "evacuate_on_zone_attack": false,
    "zone_attack_threshold": 1,
    "evacuate_urgency_threshold_sec": 1800,
    "support_others": false,
    "support_others_factor": 0.25,
    "support_others_max_villages": 2,
    "request_support_on_attack": false
  },
  "conquest": {
    "enabled": false,
    "max_radius": 20,
    "priority": "fill_gaps",
    "min_points": 100,
    "max_points": 3000,
    "loyalty_regen_per_hour": 1,
    "loyalty_drop_per_noble": 25,
    "escort_ratio": 0.5,
    "min_escort": {},
    "min_escort_total": 50,
    "escort_reserve_max_pct": 0.8,
    "escort_reserve_min_progress": 0.5
  },
  "resource_sharing": {
    "enabled": false,
    "priority": "new_villages",
    "max_sends_per_cycle": 3,
    "min_send_amount": 500,
    "receiver_fill_max_pct": 90,
    "merchant_capacity": 1000,
    "overflow_enabled": true,
    "overflow_trigger_pct": 85,
    "overflow_target_pct": 60,
    "need_enabled": true,
    "need_donor_floor": 20000
  },
  "farms": {
    "farm": true,
    "min_points": 0,
    "max_points": 50,
    "search_radius": 100,
    "default_away_time": 3600,
    "full_loot_away_time": 1800,
    "low_loot_away_time": 7200,
    "max_farms": 25,
    "attack_higher_points": false,
    "force_scout_if_available": true,
    "forced_peace_times": [],
    "farm_scout_amount": 5
  },
  "market": {
    "auto_trade": true,
    "max_trade_duration": 1,
    "auto_remove": true,
