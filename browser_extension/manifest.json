{
  "manifest_version": 3,
  "name": "TWB - sessao para o bot",
  "version": "1.0.0",
  "description": "Manda a sessao do Tribal Wars deste navegador para o painel local do TWB (127.0.0.1). Nada sai da sua maquina.",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.tribalwars.ae/*",
    "https://*.plemena.com/*",
    "https://*.divokekmeny.cz/*",
    "https://*.tribalwars.dk/*",
    "https://*.tribalwars.nl/*",
    "https://*.tribalwars.net/*",
    "https://*.tribalwars.co.uk/*",
    "https://*.tribalwars.us/*",
    "https://*.guerretribale.fr/*",
    "https://*.die-staemme.de/*",
    "https://*.fyletikesmaxes.gr/*",
    "https://*.klanhaboru.hu/*",
    "https://*.tribals.it/*",
    "https://*.tribalwars.com/*",
    "https://*.plemiona.pl/*",
    "https://*.tribalwars.com.br/*",
    "https://*.tribalwars.com.pt/*",
    "https://*.tribalwars.works/*",
    "https://*.triburile.ro/*",
    "https://*.voynaplemyon.com/*",
    "https://*.divoke-kmene.sk/*",
    "https://*.vojnaplemen.si/*",
    "https://*.guerrastribales.es/*",
    "https://*.tribalwars.se/*",
    "https://*.staemme.ch/*",
    "https://*.tribalwars.asia/*",
    "https://*.klanlar.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TWB - sessao"
  }
}
